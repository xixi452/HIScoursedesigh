# ===== 环境变量模板（提交到仓库的只有"变量名"，绝无真实值）=====
# 复制本文件为 .env 并填入真实值；.env 已被 .gitignore 忽略，绝不进仓库。

# ---- 后端（Render 后台配置）----
# JWT 签名密钥：>= 32 字符随机串，生产必须强随机
HIS_JWT_SECRET=
# 身份证脱敏加盐密钥
HIS_ID_SALT=
# SQLite 数据文件路径（本地默认 backend/data/his.db，云上留空即可）
HIS_DB_PATH=

# ---- 前端（Vercel 后台配置）----
# 后端公网地址，例如 https://his-mvp.onrender.com
VITE_API_BASE=
